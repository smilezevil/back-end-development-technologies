Content-Type: application/json

{
  "roomId": 1,
  "guestId": 1,
  "checkInDate": "2026-10-10",
  "checkOutDate": "2026-10-15",
  "status": "CONFIRMED",
  "totalPrice": 6750.00
}

###
POST http://localhost:8080/api/bookings
Content-Type: application/json

{
  "roomId": 2,
  "guestId": 2,
  "checkInDate": "2026-11-01",
  "checkOutDate": "2026-11-03",
  "status": "PENDING",
  "totalPrice": 7000.00
}

###
DELETE http://localhost:8080/api/bookings/2

###
GET http://localhost:8080/api/bookings

### 1. токен для alice
POST http://localhost:9090/realms/course-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=backend-app
    &username=alice
    &password=alice123
    &grant_type=password

> {%
    client.global.set("auth_token", response.body.access_token);
%}

### 2. Пробуємо створити кімнату з цим токеном
POST http://localhost:8080/api/rooms
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "hotelId": 1,
  "roomNumber": "999",
  "type": "STANDARD",
  "pricePerNight": 1500,
  "capacity": 2
}

### 3. токен для bob
POST http://localhost:9090/realms/course-realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=backend-app
    &username=bob
    &password=bob123
    &grant_type=password

> {%
    client.global.set("admin_token", response.body.access_token);
%}

### 4. Пробуємо створити кімнату як ADMIN
POST http://localhost:8080/api/rooms
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "hotelId": 1,
  "roomNumber": "VIP-999",
  "type": "LUXURY",
  "pricePerNight": 5000,
  "capacity": 2
}